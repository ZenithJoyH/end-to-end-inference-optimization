+@triton.jit
+def _classify_full_prefix_groups(
+    indices,
+    topk_length,
+    group_flags,
+    legacy_lengths,
+    stride_tm,
+    sq,
+    TOPK: tl.constexpr,
+    GROUP_SIZE: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    group_id = tl.program_id(0)
+    first_row = group_id * GROUP_SIZE
+    valid_group = first_row + GROUP_SIZE <= sq
+    length0 = tl.load(topk_length + first_row, mask=first_row < sq, other=0)
+    length1 = tl.load(topk_length + first_row + 1, mask=first_row + 1 < sq, other=0)
+    length2 = tl.load(topk_length + first_row + 2, mask=first_row + 2 < sq, other=0)
+    length3 = tl.load(topk_length + first_row + 3, mask=first_row + 3 < sq, other=0)
+    consecutive = (
+        (length0 > 0)
+        & (length1 == length0 + 1)
+        & (length2 == length1 + 1)
+        & (length3 == length2 + 1)
+        & (length3 <= TOPK)
+    )
+    mismatch = tl.zeros((), dtype=tl.int32)
+    for block_id in range(TOPK // BLOCK):
+        positions = block_id * BLOCK + tl.arange(0, BLOCK)
+        reference = tl.load(
+            indices + (first_row + GROUP_SIZE - 1) * stride_tm + positions,
+            mask=valid_group,
+            other=-1,
+        )
+        row0 = tl.load(
+            indices + first_row * stride_tm + positions,
+            mask=valid_group,
+            other=-1,
+        )
+        row1 = tl.load(
+            indices + (first_row + 1) * stride_tm + positions,
+            mask=valid_group,
+            other=-1,
+        )
+        row2 = tl.load(
+            indices + (first_row + 2) * stride_tm + positions,
+            mask=valid_group,
+            other=-1,
+        )
+        different = ((positions < length0) & (row0 != reference)) | (
+            (positions < length1) & (row1 != reference)
+        ) | ((positions < length2) & (row2 != reference))
+        mismatch += tl.sum(different.to(tl.int32))
+    grouped = valid_group & consecutive & (mismatch == 0)
+    tl.store(group_flags + group_id, grouped.to(tl.int32))
+    tl.store(legacy_lengths + first_row, tl.where(grouped, 0, length0), mask=first_row < sq)
+    tl.store(legacy_lengths + first_row + 1, tl.where(grouped, 0, length1), mask=first_row + 1 < sq)
+    tl.store(legacy_lengths + first_row + 2, tl.where(grouped, 0, length2), mask=first_row + 2 < sq)
