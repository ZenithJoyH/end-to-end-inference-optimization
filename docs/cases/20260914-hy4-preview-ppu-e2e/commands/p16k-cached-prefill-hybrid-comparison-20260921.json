      "direction": "lower",
      "max_regression": 0.05
    },
    {
      "metric": "p99_tpot_ms",
      "direction": "lower",
      "max_regression": 0.05
    },
    {
      "metric": "p99_itl_ms",
      "direction": "lower",
      "max_regression": 0.05
    },
    {
      "metric": "total_token_throughput",
