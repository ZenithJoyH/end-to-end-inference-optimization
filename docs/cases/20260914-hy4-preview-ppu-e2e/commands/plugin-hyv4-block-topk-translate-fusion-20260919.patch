+@triton.jit
+def _translate_hyv4_selected_block_kernel(
+    selected,
+    row_starts,
+    request_start,
+    stride_selected_row,
+    count: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    """Translate valid block Top-K positions in one in-place pass."""
+    row = tl.program_id(0)
+    columns = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    mask = columns < count
+    values = tl.load(
+        selected + row * stride_selected_row + columns,
+        mask=mask,
+    )
+    row_start = tl.load(row_starts + row)
+    translated = tl.where(
+        values >= 0,
+        values + row_start - request_start,
+        -1,
+    )
+    tl.store(
+        selected + row * stride_selected_row + columns,
+        translated,
+        mask=mask,
+    )
+
+
+def _translate_hyv4_selected_block(
+    selected: torch.Tensor,
+    row_starts: torch.Tensor,
+    request_start: int,
+) -> None:
+    """Translate block Top-K positions without boolean temporaries.
+
+    The T-Head path replaces ``ge``, ``sub``, ``add_``, ``bitwise_not`` and
+    ``masked_fill_`` with one graph-safe kernel. Other platforms and unusual
+    layouts retain the original PyTorch sequence.
+    """
+    if selected.numel() == 0:
+        return
+    if (
+        current_platform.vendor_name != "thead"
+        or selected.device.type != "cuda"
+        or selected.dtype != torch.int32
+        or selected.ndim != 2
+        or selected.stride(1) != 1
+        or row_starts.device != selected.device
+        or row_starts.dtype != torch.int32
+        or row_starts.ndim != 1
+        or row_starts.shape[0] != selected.shape[0]
+        or not row_starts.is_contiguous()
+    ):
+        valid = selected >= 0
+        selected.add_((row_starts - request_start).unsqueeze(1))
+        selected.masked_fill_(~valid, -1)
+        return
+
+    rows, count = selected.shape
+    _translate_hyv4_selected_block_kernel[
+        (rows, triton.cdiv(count, _HYV4_TOPK_TRANSLATE_BLOCK))
+    ](
+        selected,
+        row_starts,
+        request_start,
+        selected.stride(0),
+        count=count,
+        BLOCK=_HYV4_TOPK_TRANSLATE_BLOCK,
+        num_warps=4,
+        num_stages=1,
+    )
+
+
