+def test_hy4_paged_sequence_preserves_request_token_order():
+    kv_cache = torch.arange(4 * 2 * 3, dtype=torch.bfloat16).reshape(
+        4, 2, 3
+    )
+    block_table = torch.tensor([2, 0], dtype=torch.int32)
+
+    actual = hy_v4._paged_sequence(kv_cache, block_table, seq_len=3)
+
+    expected = torch.stack(
+        (
+            kv_cache[2, 0],
+            kv_cache[2, 1],
+            kv_cache[0, 0],
+        )
+    )
+    assert torch.equal(actual, expected)
+
+    empty = hy_v4._paged_sequence(kv_cache, block_table, seq_len=0)
+    assert empty.shape == (0, 3)
+
