+# Copyright (c) 2026 BAAI. All rights reserved.
+
+"""T-Head kernels for HY4 Indexer data movement."""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+
+_BLOCK_TOKENS = 2
+_BLOCK_SIZE = 64
+_HEAD_DIM = 128
+
+
+@triton.jit
+def _gather_hyv4_paged_sequence_kernel(
+    kv_cache,
+    block_table,
+    output,
+    seq_len,
+    stride_cache_block,
+    stride_cache_token,
+    stride_cache_dim,
+    stride_output_token,
+    BLOCK_SIZE: tl.constexpr,
+    HEAD_DIM: tl.constexpr,
+    BLOCK_TOKENS: tl.constexpr,
+):
+    token_offsets = (
+        tl.program_id(0) * BLOCK_TOKENS + tl.arange(0, BLOCK_TOKENS)
+    )[:, None]
+    dim_offsets = tl.arange(0, HEAD_DIM)[None, :]
+    token_mask = token_offsets < seq_len
+    logical_blocks = token_offsets // BLOCK_SIZE
+    token_in_block = token_offsets % BLOCK_SIZE
+    physical_blocks = tl.load(
+        block_table + logical_blocks,
+        mask=token_mask,
+        other=0,
+    )
+    values = tl.load(
+        kv_cache
+        + physical_blocks * stride_cache_block
+        + token_in_block * stride_cache_token
+        + dim_offsets * stride_cache_dim,
+        mask=token_mask,
+        other=0.0,
+    )
+    tl.store(
+        output + token_offsets * stride_output_token + dim_offsets,
+        values,
+        mask=token_mask,
+    )
+
+
+def gather_hyv4_paged_sequence(
+    kv_cache: torch.Tensor,
+    block_table: torch.Tensor,
+    seq_len: int,
+) -> torch.Tensor:
+    """Gather request-ordered keys without materializing the full cache.
+
+    The generic ``index_select`` implementation transposes and makes the
+    complete flattened cache contiguous before selecting a few thousand rows
+    on T-Head. This kernel follows the paged strides directly and writes only
+    the requested sequence.
+    """
+    output = torch.empty(
+        (seq_len, _HEAD_DIM),
+        device=kv_cache.device,
+        dtype=kv_cache.dtype,
+    )
+    _gather_hyv4_paged_sequence_kernel[
+        (triton.cdiv(seq_len, _BLOCK_TOKENS),)
+    ](
+        kv_cache,
+        block_table,
+        output,
+        seq_len,
+        kv_cache.stride(0),
+        kv_cache.stride(1),
+        kv_cache.stride(2),
+        output.stride(0),
+        BLOCK_SIZE=_BLOCK_SIZE,
+        HEAD_DIM=_HEAD_DIM,
+        BLOCK_TOKENS=_BLOCK_TOKENS,
+        num_warps=4,
+        num_stages=1,
+    )
+    return output
