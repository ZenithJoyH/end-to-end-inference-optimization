@@ -0,0 +1,61 @@
+# Copyright (c) 2025 BAAI. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-FL project
+
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from vllm.v1.core.sched.async_scheduler import AsyncScheduler as _AsyncScheduler
+
+from vllm_fl.worker.scheduler_fl import AsyncSchedulerFL
+
+
+def _scheduler(*, cap: int, running_prefill: bool, running_decode: bool, waiting: bool):
+    scheduler = AsyncSchedulerFL.__new__(AsyncSchedulerFL)
+    scheduler.max_num_scheduled_tokens = 2304
+    scheduler._mixed_token_budget_cap = cap
+    scheduler.running = []
+    if running_prefill:
+        scheduler.running.append(SimpleNamespace(is_prefill_chunk=True))
+    if running_decode:
+        scheduler.running.append(SimpleNamespace(is_prefill_chunk=False))
+    scheduler.waiting = [object()] if waiting else []
+    return scheduler
+
+
+def _observed_budget(self, throttle_prefills=False):
+    return self.max_num_scheduled_tokens, throttle_prefills
+
+
+def test_mixed_budget_cap_is_temporary():
+    scheduler = _scheduler(
+        cap=2048, running_prefill=False, running_decode=True, waiting=True
+    )
+    with patch.object(_AsyncScheduler, "schedule", _observed_budget):
+        assert scheduler.schedule(True) == (2048, True)
+    assert scheduler.max_num_scheduled_tokens == 2304
+
+
+def test_mixed_budget_cap_applies_to_running_partial_prefill():
+    scheduler = _scheduler(
+        cap=2048, running_prefill=True, running_decode=True, waiting=False
+    )
+    with patch.object(_AsyncScheduler, "schedule", _observed_budget):
+        assert scheduler.schedule() == (2048, False)
+    assert scheduler.max_num_scheduled_tokens == 2304
+
+
+def test_mixed_budget_cap_does_not_shrink_pure_prefill_or_decode():
+    pure_prefill = _scheduler(
+        cap=2048, running_prefill=True, running_decode=False, waiting=True
+    )
+    pure_decode = _scheduler(
+        cap=2048, running_prefill=False, running_decode=True, waiting=False
+    )
+    disabled = _scheduler(
+        cap=0, running_prefill=True, running_decode=True, waiting=True
+    )
+    with patch.object(_AsyncScheduler, "schedule", _observed_budget):
+        assert pure_prefill.schedule() == (2304, False)
+        assert pure_decode.schedule() == (2304, False)
+        assert disabled.schedule() == (2304, False)
