 from vllm.logger import init_logger
@@ -153,3 +154,49 @@ class AsyncSchedulerFL(_AsyncScheduler):
                 "(max_threads=8)."
             )
         super().__init__(*args, **kwargs)
+
+        cap_raw = os.getenv("VLLM_FL_MIXED_MAX_NUM_BATCHED_TOKENS", "0")
+        try:
+            cap = int(cap_raw)
+        except ValueError as exc:
+            raise ValueError(
+                "VLLM_FL_MIXED_MAX_NUM_BATCHED_TOKENS must be an integer"
+            ) from exc
+        if cap < 0:
+            raise ValueError(
+                "VLLM_FL_MIXED_MAX_NUM_BATCHED_TOKENS must be non-negative"
+            )
+        if cap >= self.max_num_scheduled_tokens:
+            cap = 0
+        self._mixed_token_budget_cap = cap
+        if cap:
+            logger.warning(
+                "Enabled mixed-workload token budget cap: %d (configured maximum: %d).",
+                cap,
+                self.max_num_scheduled_tokens,
+            )
+
+    def schedule(self, throttle_prefills: bool = False):
+        """Limit mixed prefill/decode steps without shrinking pure prefill batches.
+
+        This is opt-in and restores the configured budget before returning, so
+        scheduler state and the default path are unchanged when the environment
+        variable is absent.
+        """
+        cap = self._mixed_token_budget_cap
+        if not cap:
+            return super().schedule(throttle_prefills)
+
+        has_decode = any(not request.is_prefill_chunk for request in self.running)
+        has_prefill = bool(self.waiting) or any(
+            request.is_prefill_chunk for request in self.running
+        )
+        if not (has_decode and has_prefill):
+            return super().schedule(throttle_prefills)
+
+        configured_budget = self.max_num_scheduled_tokens
+        self.max_num_scheduled_tokens = min(configured_budget, cap)
+        try:
+            return super().schedule(throttle_prefills)
+        finally:
+            self.max_num_scheduled_tokens = configured_budget
