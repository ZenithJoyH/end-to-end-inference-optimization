+def _maybe_tune_qwen38_flash_block_m(
+    config: dict[str, int],
+    w1_shape: torch.Size,
+    w2_shape: torch.Size,
+    top_k: int,
+    config_dtype: str,
+    num_tokens: int,
+) -> dict[str, int]:
+    """Experimental, shape-gated BLOCK_SIZE_M-only override."""
+    if (
+        tuple(w1_shape) != (512, 160, 2560)
+        or tuple(w2_shape) != (512, 2560, 80)
+        or top_k != 10
+        or config_dtype != "bf16"
+    ):
+        return config
+    if num_tokens == 64 and config == _QWEN38_FLASH_BF16_DECODE_CONFIG:
+        tuned = config.copy()
+        tuned["BLOCK_SIZE_M"] = 16
+        logger.info_once(
+            "Using the Qwen3.8-Flash BF16 decode MoE BLOCK_SIZE_M=16 override"
+        )
+        return tuned
+    return config
