+def _maybe_tune_qwen38_flash_block_m(
+    config: dict[str, int],
+    w1_shape: torch.Size,
+    w2_shape: torch.Size,
+    top_k: int,
+    config_dtype: str,
+    num_tokens: int,
+) -> dict[str, int]:
+    """Apply the measured decode-only override for the exact supported shape."""
+    if (
+        tuple(w1_shape) != (512, 160, 2560)
+        or tuple(w2_shape) != (512, 2560, 80)
+        or top_k != 10
+        or config_dtype != "bf16"
+        or num_tokens != 64
+        or config != _QWEN38_FLASH_BF16_DECODE_CONFIG
+    ):
+        return config
+    tuned = config.copy()
+    tuned["BLOCK_SIZE_M"] = 16
+    logger.warning_once(
+        "Using Qwen3.8-Flash BF16 decode MoE BLOCK_SIZE_M=16: "
+        f"baseline={config}, selected={tuned}"
+    )
+    return tuned
