+"""Focused gates for the optional Qwen4 fused QSA compression transaction.
+
+This test module applies after ``qsa-compress-fusion-draft.patch``.  CPU tests
+cover dispatch ownership and fail-closed fallback.  Accelerator tests cover
+the exact production ABI, BF16 reference semantics, invalid-slot sentinels,
+and one capture followed by two explicit replays at stable tensor addresses.
+"""
+
+from __future__ import annotations
+
+from types import MethodType, SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import torch
+
+import vllm_fl.models.qwen3_8_flash_next as qwen_model
+from vllm_fl.dispatch import BackendImplKind, OpRegistry
+from vllm_fl.dispatch.backends.flaggems.flaggems import FlagGemsBackend
+from vllm_fl.dispatch.backends.flaggems.register_ops import register_builtins
+
+
+OP_NAME = "qwen4_compress_norm_mrope_store_groups"
+EPS = 1.0e-6
+
+
+def _guard_case(device: torch.device):
+    raw = torch.randn((2, 4, 1, 128), device=device, dtype=torch.bfloat16)
+    compressed = torch.zeros_like(raw)
+    rope = torch.zeros((2, 4, 1, 3), device=device, dtype=torch.int64)
+    cos_sin = torch.randn((32, 64), device=device, dtype=torch.bfloat16)
+    raw_metadata = SimpleNamespace(
+        block_table=torch.tensor([[1, 0]], device=device, dtype=torch.int32),
+        token_to_req=torch.tensor([0, 0], device=device, dtype=torch.int32),
+        logical_positions=torch.tensor([3, 7], device=device, dtype=torch.int64),
+    )
+    compressed_metadata = SimpleNamespace(
+        slot_mapping=torch.tensor([0, 1], device=device, dtype=torch.int64)
+    )
+    indexer = SimpleNamespace(
+        index_head_dim=128,
+        compress_ratio=4,
+        rotary_emb=SimpleNamespace(
+            rotary_dim=64,
+            mrope_section=(11, 11, 10),
+            mrope_interleaved=True,
+        ),
+        k_layernorm=SimpleNamespace(
+            weight=torch.randn((128,), device=device, dtype=torch.bfloat16)
+        ),
+    )
+    return SimpleNamespace(
+        indexer=indexer,
+        raw=raw,
+        compressed=compressed,
+        rope=rope,
+        cos_sin=cos_sin,
+        raw_metadata=raw_metadata,
+        compressed_metadata=compressed_metadata,
+    )
+
+
+def _guard(case) -> bool:
+    return qwen_model.QSAIndexer._can_use_fused_compress_transaction(
+        case.indexer,
+        case.raw_metadata,
+        case.compressed_metadata,
+        case.raw,
+        case.compressed,
+        case.rope,
+        case.cos_sin,
+    )
+
+
+def _invoke(op, case, output) -> None:
+    op(
+        case.raw,
+        case.table,
+        case.requests,
+        case.positions,
+        case.slots,
+        output,
+        case.weight,
+        case.cos_sin,
+        compress_ratio=4,
+        norm_eps=EPS,
+        rotary_dim=64,
+        mrope_section=(11, 11, 10),
+        mrope_interleaved=True,
+        rope_cache=case.rope,
+    )
+
+
+def _transaction_case(device: torch.device):
+    torch.manual_seed(1701)
+    raw_blocks, page_size = 4, 4
+    raw = torch.randn(
+        (raw_blocks, page_size, 1, 128), device=device, dtype=torch.bfloat16
+    )
+    rope = torch.empty(
+        (raw_blocks, page_size, 1, 3), device=device, dtype=torch.int64
+    )
+    physical_positions = torch.arange(
+        raw_blocks * page_size, device=device, dtype=torch.int64
+    ).reshape(raw_blocks, page_size, 1)
+    rope[..., 0] = physical_positions % 32
+    rope[..., 1] = (physical_positions + 3) % 32
+    rope[..., 2] = (physical_positions + 7) % 32
+    table = torch.tensor([[2, 0, 3]], device=device, dtype=torch.int32)
+    requests = torch.tensor([0, 0, -1, 0], device=device, dtype=torch.int32)
+    positions = torch.tensor([3, 7, 3, 3], device=device, dtype=torch.int64)
+    # Slots 0 and 5 are valid.  -1 and total-capacity 8 must be ignored.
+    slots = torch.tensor([0, 5, 2, 8], device=device, dtype=torch.int64)
+    weight = torch.randn((128,), device=device, dtype=torch.bfloat16) * 0.01
+    time = torch.arange(32, device=device, dtype=torch.float32)
+    frequency = torch.arange(32, device=device, dtype=torch.float32)
+    inv_freq = 1.0 / (10000.0 ** (frequency / 32.0))
+    angles = time[:, None] * inv_freq[None, :]
+    cos_sin = torch.cat((angles.cos(), angles.sin()), dim=-1).to(torch.bfloat16)
+    initial = torch.full(
+        (2, page_size, 1, 128),
+        7.0,
+        device=device,
+        dtype=torch.bfloat16,
+    )
+    return SimpleNamespace(
+        raw=raw,
+        rope=rope,
+        table=table,
+        requests=requests,
+        positions=positions,
+        slots=slots,
+        weight=weight,
+        cos_sin=cos_sin,
+        initial=initial,
+    )
+
+
+def _bf16_reference(case) -> torch.Tensor:
+    """Mirror the fused kernel's BF16 materialization and Gemma RMSNorm."""
+
+    output = case.initial.clone()
+    page_size = case.raw.shape[1]
+    output_capacity = output.shape[0] * output.shape[1]
+    frequencies = torch.arange(32, device=case.raw.device)
+    use_height = (frequencies % 3 == 1) & (frequencies < 3 * 11)
+    use_width = (frequencies % 3 == 2) & (frequencies < 3 * 10)
+    for row in range(case.requests.numel()):
+        request = int(case.requests[row].item())
+        end = int(case.positions[row].item())
+        slot = int(case.slots[row].item())
+        if not (
+            0 <= request < case.table.shape[0]
+            and end >= 3
+            and 0 <= slot < output_capacity
+        ):
+            continue
+        values = []
+        for position in range(end - 3, end + 1):
+            logical_page = position // page_size
+            if logical_page >= case.table.shape[1]:
+                values = []
+                break
+            physical_page = int(case.table[request, logical_page].item())
+            if not 0 <= physical_page < case.raw.shape[0]:
+                values = []
+                break
+            values.append(case.raw[physical_page, position % page_size, 0].float())
+        if not values:
+            continue
+        pooled = (torch.stack(values).sum(0) / 4).to(torch.bfloat16)
+        pooled_fp32 = pooled.float()
+        variance = pooled_fp32.square().mean()
+        normalized = (
+            pooled_fp32
+            * torch.rsqrt(variance + EPS)
+            * (case.weight.float() + 1.0)
+        ).to(torch.bfloat16)
+
+        first_position = end - 3
+        logical_page = first_position // page_size
+        physical_page = int(case.table[request, logical_page].item())
+        axes = case.rope[physical_page, first_position % page_size, 0]
+        rope_positions = torch.where(
+            use_height,
+            axes[1],
+            torch.where(use_width, axes[2], axes[0]),
+        )
+        cos = case.cos_sin[rope_positions, frequencies].float()
+        sin = case.cos_sin[rope_positions, 32 + frequencies].float()
+        first = normalized[:32].float()
+        second = normalized[32:64].float()
+        stored = torch.cat(
+            (
+                (first * cos - second * sin).to(torch.bfloat16),
+                (second * cos + first * sin).to(torch.bfloat16),
+                normalized[64:],
+            )
+        )
+        output[slot // output.shape[1], slot % output.shape[1], 0].copy_(stored)
+    return output
+
+
+def _assert_invalid_slots_untouched(actual, initial) -> None:
+    actual_rows = actual.reshape(-1, actual.shape[-1])
+    initial_rows = initial.reshape_as(actual_rows)
+    mask = torch.ones(actual_rows.shape[0], device=actual.device, dtype=torch.bool)
+    mask[torch.tensor([0, 5], device=actual.device)] = False
+    torch.testing.assert_close(actual_rows[mask], initial_rows[mask], atol=0, rtol=0)
+
+
+def _qwen4_op():
+    backend = FlagGemsBackend()
+    if not backend.qwen4_op_is_available(OP_NAME):
+        pytest.fail("FlagGems-vLLM Qwen4 fused compression op is unavailable")
+    return backend.qwen4_compress_norm_mrope_store_groups
+
+
+def test_qwen4_fused_compression_dispatch_registration(monkeypatch):
+    registration = __import__(
+        "vllm_fl.dispatch.backends.flaggems.register_ops", fromlist=["register_builtins"]
+    )
+    monkeypatch.setattr(registration, "use_flaggems_op", lambda name: name == OP_NAME)
+    registry = OpRegistry()
+    register_builtins(registry)
+    (impl,) = registry.get_implementations(OP_NAME)
+    assert impl.kind == BackendImplKind.DEFAULT
+    assert impl.impl_id == "default.flagos.qwen4"
+    assert impl.vendor is None
+
+
+@pytest.mark.gpu
+@pytest.mark.parametrize(
+    "mutation",
+    [
+        "none",
+        "wrong_ratio",
+        "wrong_sections",
+        "wrong_weight_dtype",
+        "mismatched_metadata",
+        "wrong_rope_dtype",
+    ],
+)
+def test_qwen4_fused_compression_exact_guard(monkeypatch, mutation):
+    case = _guard_case(torch.device("cuda"))
+    monkeypatch.setattr(qwen_model, "_ENABLE_QWEN4_FUSED_QSA_COMPRESS", True)
+    monkeypatch.setattr(qwen_model, "_HAS_QWEN4_FUSED_QSA_COMPRESS", True)
+    monkeypatch.setattr(qwen_model, "_qwen4_compress_norm_mrope_store_groups", Mock())
+    if mutation == "wrong_ratio":
+        case.indexer.compress_ratio = 8
+    elif mutation == "wrong_sections":
+        case.indexer.rotary_emb.mrope_section = (16, 8, 8)
+    elif mutation == "wrong_weight_dtype":
+        case.indexer.k_layernorm.weight = case.indexer.k_layernorm.weight.float()
+    elif mutation == "mismatched_metadata":
+        case.compressed_metadata.slot_mapping = (
+            case.compressed_metadata.slot_mapping[:1]
+        )
+    elif mutation == "wrong_rope_dtype":
+        case.rope = case.rope.to(torch.int32)
+    assert _guard(case) is (mutation == "none")
+
+
+def test_qwen4_fused_compression_cpu_guard_falls_back_before_launch(monkeypatch):
+    fused = Mock()
+    legacy_store = Mock()
+    pooled = torch.zeros((1, 1, 128), dtype=torch.bfloat16)
+    first_positions = torch.zeros((1, 3), dtype=torch.int64)
+    legacy_compress = Mock(return_value=(pooled, first_positions))
+    normalized = torch.ones_like(pooled)
+    normalize = Mock(return_value=normalized)
+    monkeypatch.setattr(qwen_model, "_ENABLE_QWEN4_FUSED_QSA_COMPRESS", True)
+    monkeypatch.setattr(qwen_model, "_HAS_QWEN4_FUSED_QSA_COMPRESS", True)
+    monkeypatch.setattr(qwen_model, "_qwen4_compress_norm_mrope_store_groups", fused)
+    monkeypatch.setattr(qwen_model, "_qsa_store_cache_rows", legacy_store)
+    monkeypatch.setattr(
+        qwen_model, "_qsa_compress_groups_with_ratio", legacy_compress
+    )
+
+    raw_cache = torch.zeros((1, 4, 1, 128), dtype=torch.bfloat16)
+    compressed_cache = torch.zeros_like(raw_cache)
+    cos_sin = torch.zeros((16, 64), dtype=torch.bfloat16)
+    indexer = SimpleNamespace(
+        raw_key_cache=SimpleNamespace(
+            key_cache=raw_cache,
+            rope_position_cache=None,
+        ),
+        compressed_key_cache=SimpleNamespace(kv_cache=compressed_cache),
+        index_head_dim=128,
+        compress_ratio=4,
+        rotary_emb=SimpleNamespace(
+            rotary_dim=64,
+            mrope_section=(11, 11, 10),
+            mrope_interleaved=True,
+            _match_cos_sin_cache_dtype=Mock(return_value=cos_sin),
+        ),
+        k_layernorm=SimpleNamespace(
+            weight=torch.zeros((128,), dtype=torch.bfloat16),
+            variance_epsilon=EPS,
+        ),
+        normalize_compressed_keys=normalize,
+    )
+    indexer._can_use_fused_compress_transaction = MethodType(
+        qwen_model.QSAIndexer._can_use_fused_compress_transaction,
+        indexer,
+    )
+    raw_metadata = SimpleNamespace(
+        num_actual_tokens=1,
+        slot_mapping=torch.tensor([0], dtype=torch.int64),
+        block_table=torch.tensor([[0]], dtype=torch.int32),
+        token_to_req=torch.tensor([0], dtype=torch.int32),
+        logical_positions=torch.tensor([3], dtype=torch.int64),
+    )
+    compressed_metadata = SimpleNamespace(
+        slot_mapping=torch.tensor([0], dtype=torch.int64)
+    )
+    token_k = torch.ones((1, 1, 128), dtype=torch.bfloat16)
+    qwen_model.QSAIndexer._update_and_compress(
+        indexer,
+        token_k,
+        torch.tensor([3], dtype=torch.int64),
+        raw_metadata,
+        compressed_metadata,
+    )
+
+    fused.assert_not_called()
+    legacy_compress.assert_called_once()
+    normalize.assert_called_once_with(pooled, first_positions)
+    assert legacy_store.call_count == 2
+    raw_store, compressed_store = legacy_store.call_args_list
+    assert raw_store.args[0] is raw_cache
+    assert raw_store.args[1] is raw_metadata.slot_mapping
+    assert raw_store.args[2] is token_k
+    assert compressed_store.args[0] is compressed_cache
+    assert compressed_store.args[1] is compressed_metadata.slot_mapping
+    assert compressed_store.args[2] is normalized
+
+
+@pytest.mark.gpu
+def test_qwen4_fused_compression_matches_bf16_reference_and_preserves_sentinel():
+    case = _transaction_case(torch.device("cuda"))
+    expected = _bf16_reference(case)
+    actual = case.initial.clone()
+    _invoke(_qwen4_op(), case, actual)
+    torch.cuda.synchronize()
+    torch.testing.assert_close(actual, expected, atol=0.03, rtol=0.02)
+    _assert_invalid_slots_untouched(actual, case.initial)
+
+
+@pytest.mark.gpu
+def test_qwen4_fused_compression_graph_capture_and_two_replays():
+    case = _transaction_case(torch.device("cuda"))
+    expected = _bf16_reference(case)
+    op = _qwen4_op()
+
+    warmup_output = case.initial.clone()
+    for _ in range(3):
+        _invoke(op, case, warmup_output)
+    torch.cuda.synchronize()
+
+    graph_output = case.initial.clone()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph, capture_error_mode="thread_local"):
+        _invoke(op, case, graph_output)
+    torch.cuda.synchronize()
+    captured = graph_output.clone()
+
+    graph_output.copy_(case.initial)
+    graph.replay()
+    torch.cuda.synchronize()
+    replay_one = graph_output.clone()
+
+    graph_output.copy_(case.initial)
+    graph.replay()
+    torch.cuda.synchronize()
+    replay_two = graph_output.clone()
+
+    torch.testing.assert_close(captured, expected, atol=0.03, rtol=0.02)
+    torch.testing.assert_close(replay_one, captured, atol=0, rtol=0)
+    torch.testing.assert_close(replay_two, captured, atol=0, rtol=0)
+    for output in (captured, replay_one, replay_two):
+        _assert_invalid_slots_untouched(output, case.initial)
