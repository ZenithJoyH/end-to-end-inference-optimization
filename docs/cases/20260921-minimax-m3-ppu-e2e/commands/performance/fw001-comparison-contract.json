{
  "schema_version": 1,
  "scope": "performance_only",
  "hypothesis": "Reducing max_num_batched_tokens from 8192 to 4096 reduces intermittent Prefill/Decode interference at C64 without materially reducing output throughput.",
  "variable_paths": [
    "/launch_config/max_num_batched_tokens",
    "/launch_config/launch_args/22"
