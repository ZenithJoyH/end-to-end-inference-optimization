    "direction": "lower",
    "min_improvement": 0.05
  },
  "guardrails": [
    {
      "metric": "output_throughput",
      "direction": "higher",
      "max_regression": 0.03
    },
    {
      "metric": "p99_ttft_ms",
      "direction": "lower",
      "max_regression": 0.05
    },
    {
      "metric": "total_token_throughput",
      "direction": "higher",
      "max_regression": 0.03
    }
  ],
  "repeats": {
    "min_processes": 1,
    "min_measured_rounds": 3,
    "max_relative_spread": 0.3,
    "max_baseline_drift": 0.15
  }
}
