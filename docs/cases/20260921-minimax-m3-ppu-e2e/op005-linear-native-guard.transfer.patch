 logger = logging.getLogger(__name__)
 
+# Capture the vendor mm implementation before FlagGems installs its temporary
+# CUDA registration. Calling F.linear here would re-enter this wrapper.
+_NATIVE_MM = None
+_NATIVE_MM_KEYSET = None
+if runtime.device.vendor_name == "thead" and hasattr(torch.library, "get_kernel"):
+    try:
+        _NATIVE_MM = torch.library.get_kernel(
+            torch.ops.aten.mm.default, runtime.device.dispatch_key
+        )
+        _NATIVE_MM_KEYSET = torch._C.DispatchKeySet(
+            getattr(torch._C.DispatchKey, runtime.device.dispatch_key)
+        )
+    except (AttributeError, RuntimeError):
+        # Older PyTorch builds keep the existing FlagGems implementation.
+        _NATIVE_MM = None
+        _NATIVE_MM_KEYSET = None
+
